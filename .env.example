# =============================================================================
# Go Hire Consultancy - Environment Variables Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to .env (without .example)
# 2. Replace the placeholder values with your actual credentials
# 3. NEVER commit the .env file to GitHub
# =============================================================================

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Admin contact (can also be managed in Supabase settings table)
DEFAULT_PHONE=+91 98765 43210
DEFAULT_WHATSAPP=+91 98765 43210
DEFAULT_EMAIL=hello@gohireconsultancy.com
DEFAULT_COMPANY=Go Hire Consultancy

# Payment Gateway (if you add Razorpay later)
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# =============================================================================
# SECURITY NOTES:
# - The SUPABASE_ANON_KEY is safe to expose in browser (protected by RLS)
# - NEVER expose service_role key in frontend code
# - Keep .env file in .gitignore
# - For production, use Vercel environment variables
# =============================================================================
